{
  "name": "vscode-script-panel",
  "displayName": "vscode-script-panel",
  "description": "A VSCode extension that adds a panel dedicated to running your most often used commands in a simpler way.",
  "version": "0.1.0",
  "publisher": "daniel-rösch",
  "author": "Daniel Rösch <daniel.roesch91@gmail.com>",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-script-panel.helloWorld",
        "title": "vscode-script-panel: Hallo Welt anzeigen"
      },
      {
        "command": "vscode-script-panel.refreshTree",
        "title": "vscode-script-panel: Ansicht aktualisieren"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "vscode-script-panel.treeView",
          "name": "vscode-script-panel"
        }
      ]
    },
    "configuration": {
      "title": "vscode-script-panel",
      "properties": {
        "vscode-script-panel.greeting": {
          "type": "string",
          "default": "Hallo aus vscode-script-panel!",
          "description": "Begrüßungstext, der beim Ausführen des Befehls angezeigt wird."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "npx @vscode/vsce package",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^9.14.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
